{
  "name": "pyto-base-para-generar-proyectos",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "bun test --max-workers=1",
    "build:frontend:js": "bun build src/frontend/src/main.ts --outdir src/frontend/dist --target browser",
    "build:frontend:css": "tailwindcss -i src/frontend/src/styles/tailwind-input.css -o src/frontend/dist/tailwind.css --minify",
    "build": "bun run build:frontend:js && bun run build:frontend:css",
    "db:seed:e2e": "bun run scripts/db-seed-e2e.ts",
    "e2e": "bun run build && bun run db:seed:e2e && start-server-and-test \"bun run start:e2e\" http://localhost:3050/login \"cypress run\"",
    "start:e2e": "DATA_BACKEND=postgres PORT=3050 bun run src/backend/src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "lit-html": "^3.3.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/express": "^5.0.0",
    "bun-types": "^1.3.14",
    "cypress": "^15.19.0",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^3",
    "typescript": "^6.0.3"
  }
}
